# ==================== 应用配置 ====================
APP_NAME=测试工程师助手平台
# 版本号以代码为准（app/__init__.py），无需在此配置
API_PREFIX=/api/v1
# OpenAPI / Postman 导出中的默认服务地址；换端口或内网部署时修改。
PUBLIC_BASE_URL=http://127.0.0.1:8000
DEBUG=false
LOG_LEVEL=INFO

# ==================== 存储配置 ====================
# 相对路径基于项目根目录；也可写绝对路径。
# 统一存放：uploads/（上传原文）· data/（解析结果、用例集、报告库、运行时配置）· exports/（导出归档）
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=20
# 持久化后端：json（默认，一对象一文件、零依赖）/ sqlite（SQLAlchemy，单文件 database）。
# 切到 sqlite 前请先迁移既有数据：python scripts/migrate_json_to_sqlite.py
# 迁移后不要立刻删除 storage/data 下的 JSON 文件 —— 它们就是回滚备份。
STORAGE_BACKEND=json

# ==================== 项目隔离与鉴权（v3.0） ====================
# 开启后要求所有非公开 API 携带项目身份；未开启时仍兼容既有单工作区。
PROJECT_ISOLATION_ENABLED=false
AUTH_ENABLED=false
PROJECT_HEADER=X-Project-ID
AUTH_HEADER=X-API-Key
# 仅在 AUTH_ENABLED=true 时使用，格式：
# {"token-value":{"project_id":"PRJ-xxxxxxxx","actor":"ci","role":"member"}}
AUTH_TOKENS={}
PROJECT_QUOTA_DOCUMENTS=10000
PROJECT_QUOTA_SUITES=5000
PROJECT_QUOTA_JOBS=50000

# ==================== 外部同步（v3.0） ====================
# Token 只从环境变量注入；不要写入文档、请求 fixture 或 Git。
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=
ZENTAO_BASE_URL=
ZENTAO_TOKEN=
ZENTAO_PROJECT_KEY=

# ==================== 受控 HTTP 执行（v3.0） ====================
EXECUTION_TIMEOUT_SECONDS=20
EXECUTION_MAX_CONCURRENCY=4
EXECUTION_MAX_RESPONSE_BYTES=1000000
EXECUTION_MAX_CASES=2000

# ==================== 知识库与只读助手（v3.0 合并原 V3.1） ====================
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_SEARCH_LIMIT=8
ASSISTANT_MAX_KNOWLEDGE_RESULTS=5
# 持久会话窗口与服务端硬限制；前端不能绕过。
ASSISTANT_CONTEXT_TURNS=12
ASSISTANT_CONTEXT_CHARS=24000
ASSISTANT_MAX_TURNS=30
ASSISTANT_MAX_OUTPUT_TOKENS=8192
ASSISTANT_RATE_LIMIT_PER_MINUTE=8
# DeepSeek 的 Search / Fetch 使用与 LLM_API_KEY 相同的 Bearer 鉴权，
# provider=deepseek 时会自动调用 /v1/tools/search 与 /v1/tools/fetch。
ASSISTANT_WEB_SEARCH_ENABLED=true
ASSISTANT_WEB_SEARCH_TIMEOUT=20
ASSISTANT_WEB_SEARCH_MAX_RESULTS=6
ASSISTANT_WEB_FETCH_LIMIT=2
ASSISTANT_WEB_FETCH_CHARS=12000
ASSISTANT_WEB_SEARCHES_PER_CONVERSATION=8
ASSISTANT_WEB_MIN_INTERVAL_SECONDS=2
# 其他模型若提供兼容的 Search / Fetch JSON 契约，可单独配置；
# 留空时不会猜测厂商私有接口，界面会明确显示“联网不可用”及原因。
ASSISTANT_WEB_SEARCH_BASE_URL=
ASSISTANT_WEB_SEARCH_API_KEY=

# ==================== LLM 配置（两条链路共用） ====================
# 可选值: deepseek | openai_compatible | fake | none
#   - deepseek           : 调用 DeepSeek 官方 API（需填写 LLM_API_KEY）
#   - openai_compatible  : 调用任意 OpenAI 兼容端点（需填写 LLM_BASE_URL + LLM_API_KEY）
#   - fake               : 离线假实现，仅用于测试/演示，不产生真实智能输出
#   - none               : 显式使用纯规则引擎，完全不调用大模型
# 未填写 LLM_API_KEY 时：用例生成自动降级为纯规则引擎（功能可跑通），报告链路显式提示。
#
# 说明：本文件是「基线配置」，启动即用；前端「大模型配置」页可在界面里
# 临时覆盖 provider / model / base_url / api_key 等（写入 storage/data/llm_config.json），
# 优先级高于本文件，并支持一键恢复本文件的基线。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
# 报告归纳独立温度；需求抽取/场景补缺/生成复核由 Prompt 注册表固定低温度。
REPORT_TEMPERATURE=0.3
# ==================== 设计引擎配置 ====================
# 单条需求最多生成的用例数（跨全部设计方法）。这是一道防爆护栏，不是推荐产量：
# 结构完整的需求在六种方法全开时自然产出 65~75 条，设置过小会让护栏每次触发并截掉用例。
# 触发时按「方法轮转」保留，保证每种被选中的方法都有用例进入结果（不会被先执行的方法吃光额度）。
# 界面「用例生成」页可按次覆盖这个值。
MAX_CASES_PER_REQUIREMENT=200

# 生成阶段大模型的参与方式：
#   scenario  只让场景法补充用例（默认，等于 V1.0 起的行为）
#   review    六种方法都覆盖：模型复核规则引擎的产出并给出意见（不自动改写用例）
#   enhance   review + 允许补充用例（会标成「[LLM补充] · 需复核」，并受张数上限约束）
# 说明：解析阶段的模型调用（需求结构化）不受此开关影响；这里只控制「生成阶段」。
# 费用提示：review / enhance 按「每条需求一次调用」计费，一份 5 条需求的文档约 5 次请求。
LLM_DESIGN_MODE=scenario
# 单次生成允许调用大模型的总次数上限（超出部分的需求沿用规则结果并给出告警）。
LLM_MAX_CALLS_PER_GENERATION=20

# ==================== 图片识别（多模态 OCR，V2.0） ====================
# 需求文档里的图片（Word 内嵌图 / PDF 内嵌图 / 扫描件整页 / 直接上传的截图）
# 会先被转成文字，再进入原有的「文本 -> 结构化需求」流程 ——
# 因此主模型不必支持图片输入，deepseek-flash 这类纯文本模型同样可用。
#
# 识别通道（VISION_PROVIDER）：
#   auto       默认。按 多模态模型 -> 本地 OCR -> 云端 OCR 依次尝试；都不可用时如实告警，不静默跳过。
#   vlm        只用多模态模型（需要支持图片输入的型号，如 qwen-vl-max / glm-4v-plus / gpt-4o）。
#   local-ocr  只用本地 OCR（离线、免费、只认字；需安装 rapidocr-onnxruntime 或 pytesseract / tesseract）。
#   cloud-ocr  只用云端 OCR（按 app/vision/cloud_ocr.py 的契约提供地址）。
#   fake       离线假识别：确定性占位文本，仅用于演示与自动化测试。
#   none       关闭图片识别：只保留 [图片 N] 占位与告警。
VISION_PROVIDER=auto
# 多模态模型的输出形态：
#   text      只要图里的文字（表格截图、条款截图）；识别结果可参与字段约束抽取。
#   describe  描述图片内容（原型图、流程图）；识别结果不参与字段约束抽取，需人工复核。
#   both      文字 + 描述（信息最全、费用最高）。
VISION_MODE=text
# 留空即复用 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL：主模型本来就支持看图时无需重复配置。
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_TIMEOUT=90
# 本地 OCR：BACKEND 留空即自动探测（rapidocr -> pytesseract -> tesseract 命令行）。
VISION_OCR_BACKEND=
VISION_LANGUAGES=chi_sim+eng
# 云端 OCR（通用契约：POST {URL}，请求体 {"image": "<base64>", ...}，响应取 data.text 或纯文本）。
VISION_CLOUD_URL=
VISION_CLOUD_KEY=
VISION_CLOUD_FIELD=text
# 成本与噪音控制：单文档最多识别多少张、提交前的长边上限、小于多少像素面积直接跳过。
VISION_MAX_IMAGES=20
VISION_MAX_SIDE=1600
VISION_MIN_PIXELS=4096

# ==================== 测试报告：发版判定阈值 ====================
# 这几个值只是「基线」；界面「判定阈值」面板可改可存（storage/data/report_config.json）。
VERDICT_FAIL_RATE=0.05
VERDICT_BLOCKED_RATE=0.05
VERDICT_EXECUTION_FLOOR=0.9
VERDICT_PASS_LINE=0.95
