# ==================== 应用配置 ====================
APP_NAME=测试工程师助手平台
# 版本号以代码为准（app/__init__.py），无需在此配置
API_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO

# ==================== 存储配置 ====================
# 相对路径基于项目根目录；也可写绝对路径。
# 统一存放：uploads/（上传原文）· data/（解析结果、用例集、报告库、运行时配置）· exports/（导出归档）
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=20

# ==================== LLM 配置（两条链路共用） ====================
# 可选值: deepseek | openai_compatible | fake | none
#   - deepseek           : 调用 DeepSeek 官方 API（需填写 LLM_API_KEY）
#   - openai_compatible  : 调用任意 OpenAI 兼容端点（需填写 LLM_BASE_URL + LLM_API_KEY）
#   - fake               : 离线假实现，仅用于测试/演示，不产生真实智能输出
#   - none               : 显式使用纯规则引擎，完全不调用大模型
# 未填写 LLM_API_KEY 时：用例生成自动降级为纯规则引擎（功能可跑通），报告链路显式提示。
#
# 说明：本文件是「基线配置」，启动即用；前端「大模型配置」页可在界面里
# 临时覆盖 provider / model / base_url / api_key 等（写入 storage/data/llm_config.json），
# 优先级高于本文件，并支持一键恢复本文件的基线。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
# ==================== 设计引擎配置 ====================
# 单条需求最多生成的用例数（防止边界值爆炸）
MAX_CASES_PER_REQUIREMENT=60

# ==================== 测试报告：发版判定阈值 ====================
# 这几个值只是「基线」；界面「判定阈值」面板可改可存（storage/data/report_config.json）。
VERDICT_FAIL_RATE=0.05
VERDICT_BLOCKED_RATE=0.05
VERDICT_EXECUTION_FLOOR=0.9
VERDICT_PASS_LINE=0.95
